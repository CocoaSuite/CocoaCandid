IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/windows/candid.ico"

1 VERSIONINFO
FILEVERSION @CANDID_VERSION_COMMA@,0
PRODUCTVERSION @CANDID_VERSION_COMMA@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CocoaSuite"
      VALUE "FileDescription", "CocoaCandid"
      VALUE "FileVersion", "@CANDID_VERSION@"
      VALUE "InternalName", "CocoaCandid"
      VALUE "LegalCopyright", "CocoaSuite. GNU GPL v2 or later."
      VALUE "OriginalFilename", "CocoaCandid.exe"
      VALUE "ProductName", "CocoaCandid"
      VALUE "ProductVersion", "@CANDID_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
